PORT=3002
NODE_ENV=development
DATABASE_URL=postgresql://manage:manage@localhost:5433/manage_teams?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Web OAuth — SERVER client id + secret (bắt buộc cho login trên web)
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback

# iOS native (tuỳ chọn, dùng sau khi có mobile app)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

WEB_ORIGIN=http://localhost:xxxxx
COOKIE_SECURE=false

REDIS_URL=redis://localhost:6379
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_WORKSPACE_SYNC_CRON=0 */6 * * *
GOOGLE_WORKSPACE_CONNECT_CALLBACK_URL=http://localhost:3002/orgs/me/workspace/connect/callback
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_INSTALL_CALLBACK_URL=http://localhost:3002/teams/github/install/callback
GITHUB_SYNC_CRON=0 */6 * * *

# Object storage (MinIO/S3)
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=manage-teams
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9010
FILE_MAX_BYTES=20971520

# Google Chat Bot (Phases 8–10) — off by default
GCHAT_ENABLED=false
GCHAT_PUBSUB_SUBSCRIPTION=
GCHAT_SERVICE_ACCOUNT_JSON=
GCHAT_RENEW_CRON=0 */6 * * *
GCHAT_BACKUP_CRON=0 3 * * *
GCHAT_STALE_HOURS=6
