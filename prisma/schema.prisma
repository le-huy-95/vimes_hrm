generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  invited
  disabled
}

enum TeamRole {
  lead
  member
  viewer
}

enum OAuthProvider {
  google
  google_workspace
  github
}

enum WorkspaceAuthMode {
  service_account
  oauth_admin
  none
}

enum SyncLogStatus {
  running
  success
  partial
  failed
}

enum ProjectStatus {
  active
  archived
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
}

enum GithubAccountType {
  Organization
  User
}

enum GithubDeliveryStatus {
  accepted
  processed
  ignored
  failed
}

enum FileEntityType {
  avatar
  task_attachment
  other
}

enum FileStatus {
  pending
  confirmed
  failed
}

enum ChannelType {
  team
  project
  direct
}

enum GchatSyncStatus {
  active
  expired
  error
}

enum GchatMessageSource {
  google
  app
}

enum GchatMessageSyncStatus {
  pending
  sent
  confirmed
  failed
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  createdAt DateTime @default(now()) @map("created_at")

  users                User[]
  teams                Team[]
  workspaceSettings    OrgWorkspaceSettings?
  googleWorkspaceSyncs GoogleWorkspaceSync[]
  googleGroupTeamMaps  GoogleGroupTeamMap[]
  syncLogs             SyncLog[]
  githubConnections    GithubConnection[]

  @@map("organizations")
}

model User {
  id           String     @id @default(cuid())
  orgId        String     @map("org_id")
  email        String     @unique
  fullName     String     @map("full_name")
  passwordHash String?    @map("password_hash")
  googleUserId String?    @unique @map("google_user_id")
  avatarFileId String?    @map("avatar_file_id")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")

  org                        Organization          @relation(fields: [orgId], references: [id])
  refreshTokens              RefreshToken[]
  teamMembers                TeamMember[]
  oauthConnections           OauthConnection[]
  auditLogs                  AuditLog[]            @relation("AuditActor")
  googleWorkspaceLinks       GoogleWorkspaceSync[]
  githubConnectionsConnected GithubConnection[]    @relation("GithubConnectedBy")
  assignedTasks              Task[]                @relation("TaskAssignee")
  taskComments               TaskComment[]
  avatarFile                 File?                 @relation("UserAvatar", fields: [avatarFileId], references: [id])
  uploadedFiles              File[]                @relation("FileUploader")
  messagesSent               Message[]             @relation("MessageSender")
  messageReads               MessageReadStatus[]
  gchatMessages              GchatMessage[]        @relation("GchatSenderUser")
  idempotencyKeys            IdempotencyKey[]

  @@index([orgId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Team {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  parentTeamId String?  @map("parent_team_id")
  name         String
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  org              Organization          @relation(fields: [orgId], references: [id])
  parent           Team?                 @relation("TeamTree", fields: [parentTeamId], references: [id])
  children         Team[]                @relation("TeamTree")
  members          TeamMember[]
  googleGroupMaps  GoogleGroupTeamMap[]
  githubConnection GithubConnection?
  githubRepos      GithubRepo[]
  githubActivity   GithubActivityEvent[]
  projects         Project[]
  channels         Channel[]
  gchatSpaces      GchatSpace[]

  @@index([orgId])
  @@index([parentTeamId])
  @@map("teams")
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  userId      String   @map("user_id")
  role        TeamRole
  githubLogin String?  @map("github_login")
  joinedAt    DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model RolePermission {
  id            String @id @default(cuid())
  roleName      String @map("role_name")
  permissionKey String @map("permission_key")

  @@unique([roleName, permissionKey])
  @@map("roles_permissions")
}

model OauthConnection {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  provider        OAuthProvider
  accessTokenEnc  String        @map("access_token_enc")
  refreshTokenEnc String?       @map("refresh_token_enc")
  scope           String?
  expiresAt       DateTime?     @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("oauth_connections")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model OrgWorkspaceSettings {
  orgId                 String            @id @map("org_id")
  directorySyncToken    String?           @map("directory_sync_token")
  lastFullSyncAt        DateTime?         @map("last_full_sync_at")
  lastIncrementalSyncAt DateTime?         @map("last_incremental_sync_at")
  authMode              WorkspaceAuthMode @default(none) @map("auth_mode")
  syncCursorPageToken   String?           @map("sync_cursor_page_token")
  workspaceOauthUserId  String?           @map("workspace_oauth_user_id")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_workspace_settings")
}

model GoogleWorkspaceSync {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  googleUserId String   @map("google_user_id")
  primaryEmail String   @map("primary_email")
  fullName     String   @map("full_name")
  orgUnit      String?  @map("org_unit")
  photoUrl     String?  @map("photo_url")
  suspended    Boolean  @default(false)
  linkedUserId String?  @map("linked_user_id")
  contentHash  String   @map("content_hash")
  lastSyncedAt DateTime @map("last_synced_at")

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  linkedUser User?        @relation(fields: [linkedUserId], references: [id])

  @@unique([orgId, googleUserId])
  @@index([orgId, primaryEmail])
  @@index([orgId, lastSyncedAt])
  @@map("google_workspace_sync")
}

model GoogleGroupTeamMap {
  id               String @id @default(cuid())
  orgId            String @map("org_id")
  googleGroupId    String @map("google_group_id")
  googleGroupEmail String @map("google_group_email")
  teamId           String @map("team_id")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([orgId, googleGroupId])
  @@index([orgId])
  @@map("google_group_team_maps")
}

model SyncLog {
  id           String        @id @default(cuid())
  orgId        String        @map("org_id")
  provider     String
  entityType   String        @map("entity_type")
  status       SyncLogStatus
  errorMessage String?       @map("error_message")
  meta         Json?
  runAt        DateTime      @default(now()) @map("run_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, runAt(sort: Desc)])
  @@map("sync_logs")
}

model GithubConnection {
  id                 String            @id @default(cuid())
  teamId             String            @unique @map("team_id")
  orgId              String            @map("org_id")
  installationId     BigInt            @map("installation_id")
  githubAccountLogin String            @map("github_account_login")
  githubAccountType  GithubAccountType @map("github_account_type")
  githubTeamId       BigInt?           @map("github_team_id")
  connectedByUserId  String?           @map("connected_by_user_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectedBy User?        @relation("GithubConnectedBy", fields: [connectedByUserId], references: [id])
  repos       GithubRepo[]

  @@index([installationId])
  @@index([orgId])
  @@map("github_connections")
}

model GithubRepo {
  id            String    @id @default(cuid())
  teamId        String    @map("team_id")
  connectionId  String    @map("connection_id")
  githubRepoId  BigInt    @map("github_repo_id")
  fullName      String    @map("full_name")
  defaultBranch String?   @map("default_branch")
  private       Boolean   @default(false)
  htmlUrl       String    @map("html_url")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  team       Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  connection GithubConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  activity   GithubActivityEvent[]

  @@unique([teamId, githubRepoId])
  @@index([teamId])
  @@index([connectionId])
  @@map("github_repos")
}

model GithubWebhookDelivery {
  id          String               @id @default(cuid())
  deliveryId  String               @unique @map("delivery_id")
  event       String
  action      String?
  receivedAt  DateTime             @default(now()) @map("received_at")
  processedAt DateTime?            @map("processed_at")
  status      GithubDeliveryStatus @default(accepted)

  @@map("github_webhook_deliveries")
}

model GithubActivityEvent {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  repoId      String?  @map("repo_id")
  eventType   String   @map("event_type")
  action      String?
  actorLogin  String?  @map("actor_login")
  title       String
  externalUrl String?  @map("external_url")
  occurredAt  DateTime @map("occurred_at")
  dedupeKey   String   @unique @map("dedupe_key")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  team Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  repo GithubRepo? @relation(fields: [repoId], references: [id], onDelete: SetNull)

  @@index([teamId, occurredAt(sort: Desc)])
  @@map("github_activity_events")
}

model Project {
  id        String        @id @default(cuid())
  teamId    String        @map("team_id")
  name      String
  status    ProjectStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([teamId])
  @@map("projects")
}

model Task {
  id             String       @id @default(cuid())
  projectId      String       @map("project_id")
  title          String
  description    String?
  assigneeId     String?      @map("assignee_id")
  status         TaskStatus   @default(todo)
  priority       TaskPriority @default(medium)
  githubIssueUrl String?      @map("github_issue_url")
  dueDate        DateTime?    @map("due_date")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model File {
  id           String         @id @default(cuid())
  uploaderId   String         @map("uploader_id")
  orgId        String         @map("org_id")
  bucketKey    String         @unique @map("bucket_key")
  thumbnailKey String?        @map("thumbnail_key")
  originalName String         @map("original_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  entityType   FileEntityType @map("entity_type")
  entityId     String?        @map("entity_id")
  status       FileStatus     @default(confirmed)
  createdAt    DateTime       @default(now()) @map("created_at")

  uploader    User             @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  avatarUsers User[]           @relation("UserAvatar")
  attachments TaskAttachment[]
  messages    Message[]

  @@index([orgId])
  @@index([uploaderId])
  @@index([entityType, entityId])
  @@map("files")
}

model TaskAttachment {
  id     String @id @default(cuid())
  taskId String @map("task_id")
  fileId String @map("file_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([taskId, fileId])
  @@index([taskId])
  @@index([fileId])
  @@map("task_attachments")
}

model Channel {
  id        String      @id @default(cuid())
  teamId    String      @map("team_id")
  projectId String?     @map("project_id")
  name      String
  type      ChannelType
  createdAt DateTime    @default(now()) @map("created_at")

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([teamId, type])
  @@index([teamId])
  @@map("channels")
}

model Message {
  id               String   @id @default(cuid())
  channelId        String   @map("channel_id")
  senderId         String   @map("sender_id")
  content          String
  attachmentFileId String?  @map("attachment_file_id")
  replyToId        String?  @map("reply_to_id")
  createdAt        DateTime @default(now()) @map("created_at")

  channel    Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender     User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachment File?               @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)
  replyTo    Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[]           @relation("MessageReplies")
  reads      MessageReadStatus[]

  @@index([channelId, createdAt])
  @@map("messages")
}

model MessageReadStatus {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_read_status")
}

model GchatSpace {
  id                     String         @id @default(cuid())
  teamId                 String         @map("team_id")
  googleSpaceId          String         @unique @map("google_space_id")
  displayName            String         @map("display_name")
  subscriptionId         String?        @map("subscription_id")
  subscriptionExpireTime DateTime?      @map("subscription_expire_time")
  syncStatus             GchatSyncStatus @default(active) @map("sync_status")
  createdAt              DateTime       @default(now()) @map("created_at")

  team     Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages GchatMessage[]
  health   GchatSubscriptionHealth?

  @@index([teamId])
  @@map("gchat_spaces")
}

model GchatDmMapping {
  id            String   @id @default(cuid())
  userAId       String   @map("user_a_id")
  userBId       String   @map("user_b_id")
  googleSpaceId String   @map("google_space_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userAId, userBId])
  @@index([googleSpaceId])
  @@map("gchat_dm_mapping")
}

model GchatMessage {
  id              String                 @id @default(cuid())
  gchatSpaceId    String                 @map("gchat_space_id")
  googleMessageId String                 @unique @map("google_message_id")
  senderGoogleId  String?                @map("sender_google_id")
  senderUserId    String?                @map("sender_user_id")
  textContent     String                 @map("text_content")
  threadId        String?                @map("thread_id")
  source          GchatMessageSource
  syncStatus      GchatMessageSyncStatus @default(pending) @map("sync_status")
  isDeleted       Boolean                @default(false) @map("is_deleted")
  createdTime     DateTime               @map("created_time")
  updatedTime     DateTime?              @map("updated_time")
  rawPayload      Json?                  @map("raw_payload")

  space  GchatSpace @relation(fields: [gchatSpaceId], references: [id], onDelete: Cascade)
  sender User?      @relation("GchatSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([gchatSpaceId, createdTime])
  @@map("gchat_messages")
}

model GchatSubscriptionHealth {
  id                  String    @id @default(cuid())
  gchatSpaceId        String    @unique @map("gchat_space_id")
  status              String    @default("ok")
  lastEventReceivedAt DateTime? @map("last_event_received_at")
  lastRenewAt         DateTime? @map("last_renew_at")
  errorMessage        String?   @map("error_message")

  space GchatSpace @relation(fields: [gchatSpaceId], references: [id], onDelete: Cascade)

  @@map("gchat_subscription_health")
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String
  userId         String   @map("user_id")
  route          String
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@index([createdAt])
  @@map("idempotency_keys")
}
