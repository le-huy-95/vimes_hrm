// Copy to Secrets.xcconfig (gitignored). Prefer syncing values from project-root `.env`.
// MAPS_API_KEY -> GMS_API_KEY
// GOOGLE_IOS_CLIENT_ID -> GID_CLIENT_ID
// GOOGLE_SERVER_CLIENT_ID -> GID_SERVER_CLIENT_ID
// GOOGLE_IOS_URL_SCHEME -> GID_URL_SCHEME
GMS_API_KEY=your_google_maps_api_key_here
GID_CLIENT_ID=your_ios_oauth_client_id.apps.googleusercontent.com
GID_SERVER_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com
GID_URL_SCHEME=com.googleusercontent.apps.your_ios_oauth_client_id
