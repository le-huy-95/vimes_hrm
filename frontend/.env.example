# dev, prod
APP_ENV=dev
API_IMG_URL=
API_DEV_URL=http://localhost:3200
API_PROD_URL=http://localhost:3200
SOCKET_BASE_URL=http://localhost:3204
SOCKET_DEV_URL=http://localhost:3204
SOCKET_PROD_URL=http://localhost:3204
# API base: https://<host>/api/v1
NOTIFICATION_API_URL=http://localhost:3000/api/v1
# WebSocket: wss://<host>/notifications?token=...
NOTIFICATION_WS_URL=ws://localhost:3000/notifications
DEEP_LINK_HOST=localhost
CURRENCY=VND

SMS_BASE_URL=
SMS_API_KEY=

# Google Maps SDK (Android Manifest + iOS GMSServices / Secrets.xcconfig)
MAPS_API_KEY=

# Google Sign-In — GOOGLE_SERVER_CLIENT_ID = Web client ID (OAuth 2.0 Web application)
# Google Cloud Console → Credentials → client đó → Authorized JavaScript origins:
#   http://localhost
#   http://localhost:8080
# Chạy web: ./tool/run_chrome.sh   (hoặc flutter run -d chrome --web-hostname localhost --web-port 8080)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
