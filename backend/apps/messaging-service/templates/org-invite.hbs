{{#> layout emailTitle="Lời mời tổ chức trên Vimes"}}
  <h2 style="margin:0 0 16px;color:#111827;font-size:22px;font-weight:700;">Mời tham gia tổ chức trên Vimes</h2>
  <p style="margin:0 0 24px;color:#374151;font-size:15px;line-height:1.6;">
    Xin chào,<br>
    <strong>{{inviterName}}</strong> mời bạn vào tổ chức <strong>{{orgName}}</strong> trên
    <strong>{{siteName}}</strong> với vai trò <strong>{{roleLabel}}</strong>.
  </p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0fdfa;border-radius:8px;margin-bottom:24px;">
    <tr>
      <td style="padding:16px 20px;width:50%;">
        <p style="margin:0;color:#6b7280;font-size:13px;">Tổ chức</p>
        <p style="margin:4px 0 0;color:#111827;font-size:16px;font-weight:600;">{{orgName}}</p>
      </td>
      <td style="padding:16px 20px;width:50%;">
        <p style="margin:0;color:#6b7280;font-size:13px;">Vai trò</p>
        <p style="margin:4px 0 0;color:#111827;font-size:16px;font-weight:600;">{{roleLabel}}</p>
      </td>
    </tr>
  </table>
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px;">
    <tr>
      <td style="background-color:#0f766e;border-radius:8px;">
        <a href="{{acceptUrl}}" style="display:inline-block;padding:12px 32px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;">Chấp nhận lời mời</a>
      </td>
    </tr>
  </table>
  <p style="margin:0;color:#6b7280;font-size:13px;line-height:1.6;">
    Lời mời hết hạn sau <strong>{{expiryHours}} giờ</strong>. Hãy đăng nhập Vimes bằng đúng email được mời để chấp nhận.
  </p>
{{/layout}}
