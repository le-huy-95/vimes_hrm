POSTGRES_URL=postgresql://mt:mt@localhost:15432/manage_teams
# Primary ghi (Prisma). Có thể trùng POSTGRES_URL.
DATABASE_URL=postgresql://mt:mt@localhost:15432/manage_teams
# Đọc (replica). Để trống = dùng cùng DATABASE_URL — phase sau gắn replica tại đây.
# DATABASE_URL_READ=postgresql://mt:mt@localhost:15432/manage_teams
REDIS_URL=redis://localhost:16379
KAFKA_BROKERS=localhost:9092
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=manage-teams
MINIO_USE_SSL=false
LOG_LEVEL=info
NODE_ENV=development
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_SERVICE_TOKEN=dev-internal-token
CHAT_URL=http://localhost:3204
AI_URL=http://localhost:3205
GOOGLE_SYNC_URL=http://localhost:3207
WORKER_URL=http://localhost:3206
# Alias cũ (tương thích): MESSAGING_URL
MESSAGING_URL=http://localhost:3206
IDENTITY_URL=http://localhost:3202
CORE_URL=http://localhost:3203
# Dev: gateway cũng cho phép mọi http(s)://localhost|127.0.0.1:* (Flutter web port ngẫu nhiên).
# Production: liệt kê đủ origin; không dùng *.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
AUTH_RATE_LIMIT_PER_MIN=30
API_RATE_LIMIT_PER_MIN=120
CHAT_RATE_LIMIT_PER_MIN=60
CHAT_LAST_N=50
CHAT_LAST_N_TTL_SEC=300
# Phase 1.6 — trần 1 file (mặc định 2GB); quota tổng READY theo group (để trống = không giới hạn)
# MAX_FILE_BYTES=2147483648
# GROUP_FILE_QUOTA_BYTES=
# FILE_ORPHAN_CLEANUP_MS=900000
APP_PUBLIC_URL=http://localhost:3000
OTP_EXPIRES_MINUTES=10
ORG_INVITE_EXPIRY_HOURS=72
# Google OAuth2 + PKCE (identity + google-sync Tasks)
# Bật Google Tasks API trên Cloud Console; scope tasks nằm trong authorize URL / Flutter authorizeServer.
# Xem docs/runbooks/google-tasks-sync-setup.md
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=required-for-serverAuthCode-exchange
# GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-long-random-secret
# GOOGLE_TASKS_LIST_TITLE=Manage Teams
# GOOGLE_TASKS_PUSH_DEBOUNCE_MS=10000
# SYNC_WORKER_INTERVAL_MS=3000
# GOOGLE_TASKS_PULL_COOLDOWN_MS=300000
# GOOGLE_TASKS_PULL_OVERLAP_MS=45000
# Phase 4 — Sheets / Drive (mặc định local matrix; bật LIVE khi đã OAuth + API)
# GOOGLE_SHEETS_LIVE=true
# GOOGLE_SHEETS_DEBOUNCE_MS=45000
# HTTPS công khai trỏ gateway/google-sync POST /drive/webhook
# GOOGLE_DRIVE_WEBHOOK_URL=https://api.example.com/drive/webhook
# GOOGLE_CHAT_VERIFICATION_TOKEN=dev-google-chat-verification
# Phase 6a — AI (mock-first; Codex/OpenAI via OPENAI_*)
# AI_PROVIDER=auto
# AI_REQUIRE_LLM=false
# AI_MAX_TOOL_ROUNDS=8
# AI_CHAT_TIMEOUT_MS=30000
# AI_RATE_LIMIT_PER_MIN=10
# AI_TOKEN_BUDGET_PER_DAY=200000
# ANTHROPIC_API_KEY=
# AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENAI_MODEL=
# APP_PUBLIC_URL=http://localhost:3000
# PLATFORM_ADMIN_USER_IDS=uuid1,uuid2
# Email / SMTP — không cấu hình thì worker chỉ ghi inbox bộ nhớ (GET /internal/email/sent)
# Port từ test-y-Backend / Gmail App Password (điền local, không commit secret)
DEFAULT_FROM_ADDRESS=
DEFAULT_FROM_NAME=Vimes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Ưu tiên SMTP_FROM; nếu trống → "DEFAULT_FROM_NAME <DEFAULT_FROM_ADDRESS>"
# SMTP_FROM="Vimes <you@gmail.com>"
# Backup: pnpm backup:postgres  (cần pg_dump; BACKUP_DIR=./backups)
